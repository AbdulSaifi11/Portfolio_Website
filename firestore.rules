rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'REPLACE_WITH_ADMIN_UID';
    }

    function validMessage(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'address', 'status', 'createdAt'])
        && data.keys().hasOnly(['name', 'email', 'phone', 'address', 'status', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 3 && data.email.size() <= 254
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.phone is string && data.phone.matches('^[0-9+() .-]{10,30}$')
        && data.address is string && data.address.size() <= 300
        && data.status in ['new', 'read', 'archived']
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /contactMessages/{messageId} {
      // Visitors can submit valid contact messages, but cannot read them.
      allow create: if validMessage(request.resource.data)
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && !('updatedAt' in request.resource.data);

      // Only the administrator can list, read, update, or delete messages.
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && validMessage(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
